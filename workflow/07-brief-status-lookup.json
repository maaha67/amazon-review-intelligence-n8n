  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $json;\nconst requestedId = $('Brief ID input').first().json.brief_id;\n\nif (!row.brief_id) {\n  return {\n    json: {\n      found: false,\n      brief_id: requestedId,\n      message: `No brief found with ID ${requestedId}.`\n    }\n  };\n}\n\nreturn {\n  json: {\n    found: true,\n    brief_id: row.brief_id,\n    asin: row.asin,\n    status: row.status,\n    created_at: row.created_at,\n    reviewer_notes: row.reviewer_notes || \"\"\n  }\n};"
      },
