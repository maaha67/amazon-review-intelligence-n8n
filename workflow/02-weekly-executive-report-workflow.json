    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"report_title\": \"Weekly Amazon Review Intelligence Report\",\n  \"executive_summary\": \"Customer feedback is generally positive, although packaging-related concerns require attention.\",\n  \"customer_sentiment_overview\": \"Positive reviews emphasize product effectiveness while negative feedback focuses on packaging and listing clarity.\",\n  \"top_customer_risk\": \"Damaged or improperly sealed packaging is the most significant customer risk.\",\n  \"strongest_positive_signal\": \"Customers frequently report satisfaction with the product experience.\",\n  \"product_recommendation\": \"Review packaging quality-control procedures and seal integrity.\",\n  \"listing_recommendation\": \"Clarify dosage instructions and product-use expectations in the listing and A+ Content.\",\n  \"creative_recommendation\": \"Test customer-led creative focusing on ease of use, subject to compliance review.\",\n  \"priority_action_next_7_days\": \"Investigate the highest-priority packaging complaints and assign an owner.\",\n  \"management_note\": \"Continue monitoring packaging, customer expectations, and listing clarity.\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        224,
        528
      ],
      "id": "a1c39442-e77d-46f3-a66f-19f87765dfdc",
      "name": "AI Output — Executive Report Schema"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior Voice of Customer and e-commerce intelligence analyst.\n\nCreate a concise weekly executive report for an Amazon brand manager using the structured review intelligence supplied below.\n\nREVIEW INTELLIGENCE DATA\n\n{{ JSON.stringify($json, null, 2) }}\n\nREPORT REQUIREMENTS\n\n1. Explain the overall customer sentiment in plain business language.\n2. Identify the most important customer risk.\n3. Identify the strongest positive customer signal.\n4. Recommend one product or packaging action.\n5. Recommend one Amazon listing or A+ Content improvement.\n6. Recommend one advertising or creative-testing opportunity.\n7. State the single most important action for the next seven days.\n8. End with a short management note explaining what should continue to be monitored.\n\nIMPORTANT RULES\n\n- Use only the supplied review intelligence.\n- Do not invent sales, conversion, revenue, return-rate or performance data.\n- Do not treat one review as a proven market-wide trend.\n- Prioritize themes supported by multiple reviews when possible.\n- Clearly distinguish customer-reported feedback from verified product facts.\n- Do not turn supplement or health feedback into an approved medical claim.\n- Any health-related creative recommendation must require legal or compliance review.\n- Keep every recommendation practical and specific.\n- Do not mention that you are an AI.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        80,
        320
      ],
      "id": "ed4bb653-67f5-4fdc-9336-b061cf7e9502",
      "name": "04 — Write Weekly Executive Report",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "notesInFlow": true,
      "notes": "Evidence-based management report with compliance guardrails"
    },
    {
      "parameters": {
        "jsCode": "const reviews = $input\n  .all()\n  .map((item) => item.json)\n  .filter((review) => review.review_id);\n\nfunction text(value) {\n  return String(value || \"\").trim().toLowerCase();\n}\n\nfunction number(value) {\n  const converted = Number(value);\n  return Number.isFinite(converted) ? converted : 0;\n}\n\nfunction boolean(value) {\n  return value === true || text(value) === \"true\";\n}\n\nfunction average(fieldName) {\n  if (reviews.length === 0) {\n    return 0;\n  }\n\n  const total = reviews.reduce(\n    (sum, review) => sum + number(review[fieldName]),\n    0\n  );\n\n  return Number((total / reviews.length).toFixed(2));\n}\n\nfunction count(fieldName, expectedValue) {\n  return reviews.filter(\n    (review) =>\n      text(review[fieldName]) === text(expectedValue)\n  ).length;\n}\n\nconst themeCounts = {};\n\nfor (const review of reviews) {\n  const theme = text(review.primary_theme) || \"unclassified\";\n\n  themeCounts[theme] = (themeCounts[theme] || 0) + 1;\n}\n\nconst topThemes = Object.entries(themeCounts)\n  .sort((first, second) => second[1] - first[1])\n  .slice(0, 5)\n  .map(([theme, total]) => ({\n    theme,\n    total,\n  }));\n\nconst urgentReviews = reviews\n  .filter(\n    (review) =>\n      text(review.priority_level) === \"critical\" ||\n      text(review.priority_level) === \"high\"\n  )\n  .sort(\n    (first, second) =>\n      number(second.priority_score) -\n      number(first.priority_score)\n  )\n  .slice(0, 5)\n  .map((review) => ({\n    review_id: review.review_id,\n    product_name: review.product_name,\n    rating: number(review.rating),\n    priority_level: review.priority_level,\n    priority_score: number(review.priority_score),\n    primary_theme: review.primary_theme,\n    customer_issue: review.customer_issue,\n    recommended_action: review.recommended_action,\n  }));\n\nconst positiveSignals = reviews\n  .filter(\n    (review) =>\n      text(review.positive_signal) !== \"none\" &&\n      text(review.positive_signal) !== \"\"\n  )\n  .slice(0, 5)\n  .map((review) => ({\n    review_id: review.review_id,\n    theme: review.primary_theme,\n    positive_signal: review.positive_signal,\n  }));\n\nconst reportData = {\n  report_generated_at: new Date().toISOString(),\n\n  total_reviews_analyzed: reviews.length,\n\n  sentiment_breakdown: {\n    positive: count(\"sentiment\", \"positive\"),\n    negative: count(\"sentiment\", \"negative\"),\n    mixed: count(\"sentiment\", \"mixed\"),\n    neutral: count(\"sentiment\", \"neutral\"),\n  },\n\n  priority_breakdown: {\n    critical: count(\"priority_level\", \"critical\"),\n    high: count(\"priority_level\", \"high\"),\n    medium: count(\"priority_level\", \"medium\"),\n    low: count(\"priority_level\", \"low\"),\n  },\n\n  average_rating: average(\"rating\"),\n  average_sentiment_score: average(\"sentiment_score\"),\n  average_priority_score: average(\"priority_score\"),\n\n  listing_opportunities: reviews.filter(\n    (review) => boolean(review.listing_opportunity)\n  ).length,\n\n  creative_opportunities: reviews.filter(\n    (review) => boolean(review.creative_opportunity)\n  ).length,\n\n  alert_worthy_reviews: reviews.filter(\n    (review) => boolean(review.requires_alert)\n  ).length,\n\n  top_themes: topThemes,\n  urgent_reviews: urgentReviews,\n  positive_signals: positiveSignals,\n};\n\nreturn [\n  {\n    json: reportData,\n  },\n];"
      },
