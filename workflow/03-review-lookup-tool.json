    {
      "parameters": {
        "jsCode": "const requestedAsin = String(\n  $(\"Review Lookup Input\").first().json.asin ?? \"\"\n).trim();\n\nconst reviews = $input.all()\n  .map(item => item.json)\n  .filter(row => {\n    const rowAsin = String(\n      row.asin ?? row[\" asin\"] ?? \"\"\n    ).trim();\n\n    return rowAsin === requestedAsin && row.review_id;\n  })\n  .map(row => ({\n    review_id: row.review_id,\n    rating: row.rating ?? null,\n    primary_theme: row.primary_theme ?? \"\",\n    customer_issue: row.customer_issue ?? \"\",\n    positive_signal: row.positive_signal ?? \"\",\n    severity: row.severity ?? \"\",\n    listing_opportunity: row.listing_opportunity ?? \"\",\n    creative_opportunity: row.creative_opportunity ?? \"\",\n    recommended_action: row.recommended_action ?? \"\"\n  }));\n\nreturn [{\n  json: {\n    asin: requestedAsin,\n    review_count: reviews.length,\n    reviews\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
